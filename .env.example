# Copie este archivo a apps/web/.env.local y complete los valores.
# Nunca suba claves reales al repositorio.

# --- Sitio ---
# URL pública del sitio (sin barra final). Se usa en SEO, Open Graph y enlaces.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp de ventas, solo dígitos con código de país (506 + 8 dígitos).
NEXT_PUBLIC_WHATSAPP_NUMBER=50600000000

# --- Supabase (base de datos y autenticación) ---
# Panel de Supabase > Project Settings > API Keys.
# En local: `pnpm supabase status` muestra API_URL, PUBLISHABLE_KEY y SECRET_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: solo en el servidor (script de datos demo). Salta la seguridad
# por filas, así que nunca debe llegar al navegador.
SUPABASE_SECRET_KEY=

# --- Fases siguientes (todavía sin uso) ---
# Fase 2: ANTHROPIC_API_KEY, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, WHATSAPP_ACCESS_TOKEN
# Fase 3: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# Fase 4: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN
# Fase 5: claves de la pasarela de pagos
